     """Implements the GraalVM repository rule (`graalvm_repository`)."""
 
+    # s390x: GraalVM CE/Oracle has no s390x distribution. Create a stub
+    # repository so the fetch succeeds and native_image() build steps succeed.
+    _supported_arches = ["x86_64", "amd64", "aarch64"]
