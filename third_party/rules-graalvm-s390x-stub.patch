+            "filegroup(name = \"jre\", srcs = [])\n" +
+            "filegroup(name = \"jdk-bin\", srcs = [])\n" +
+            "filegroup(name = \"jdk-conf\", srcs = [])\n" +
+            "filegroup(name = \"jdk-include\", srcs = [])\n" +
+            "filegroup(name = \"jdk-lib\", srcs = [])\n" +
+            "load(\"@rules_java//java:defs.bzl\", \"java_runtime\")\n" +
+            "java_runtime(name = \"jdk\", srcs = [], version = 21)\n" +
+            "load(\"@rules_graalvm//internal:toolchain.bzl\", \"graalvm_sdk\")\n" +
+            "graalvm_sdk(name = \"gvm\", native_image_bin = \":native-image\", gvm_files = \":files\")\n",
+        )
+        ctx.file("WORKSPACE.bazel", "workspace(name = \"" + ctx.name + "\")\n")
+        return
