+        stub_script = (
+            "#!/bin/bash\n" +
+            "out_dir=''\n" +
+            "out_name=''\n" +
+            "for arg in \"$@\"; do\n" +
+            "  case \"$arg\" in\n" +
+            "    -H:Path=*) out_dir=\"${arg#-H:Path=}\" ;;\n" +
+            "    -H:Name=*) out_name=\"${arg#-H:Name=}\" ;;\n" +
+            "  esac\n" +
+            "done\n" +
+            "if [[ -n \"$out_dir\" && -n \"$out_name\" ]]; then\n" +
+            "  mkdir -p \"$out_dir\"\n" +
+            "  printf '#!/bin/bash\\necho stub >&2\\nexit 1\\n' > \"$out_dir/$out_name\"\n" +
+            "  chmod +x \"$out_dir/$out_name\"\n" +
+            "  exit 0\n" +
+            "fi\n" +
+            "echo 'GraalVM native-image is not available on " + ctx.os.arch + "' >&2\n" +
+            "exit 1\n"
+        )
+        ctx.file("native-image", stub_script, executable = True)
+        ctx.file(
+            "BUILD.bazel",
+            "package(default_visibility = [\"//visibility:public\"])\n" +
+            "exports_files([\"native-image\"])\n" +
